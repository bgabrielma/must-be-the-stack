ll, "author": null, "contributor": null, "rationale": "save-result records each query/path/explain answer with an outcome (useful/dead_end/corrected); graphify reflect --if-stale regenerates LESSONS.md (preferred sources, dead ends, corrections) cheaply and deterministically so future sessions don't re-derive the same dead ends."}], "edges": [{"source": "claude_skills_graphify_references_query_doc", "target": "graphify_query_vocab_expansion_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_doc", "target": "graphify_reflect_lessons_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_doc", "target": "graphify_query_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_doc", "target": "graphify_path_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_doc", "target": "graphify_explain_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}], "hyperedges": []}