{"nodes": [{"id": "claude_skills_graphify_skill_doc", "label": "/graphify Skill Definition (SKILL.md)", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_skill_concept", "label": "graphify (knowledge graph tool)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_semantic_cache_concept", "label": "Semantic extraction cache (per-file, prompt-stamped)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache entries are attributed to the extraction-spec.md prompt file that produced them; when the prompt changes on a graphify upgrade, old-prompt entries are re-extracted instead of replayed, while unchanged-prompt entries keep being served from cache, avoiding redundant LLM calls on unchanged files."}, {"id": "graphify_shrink_guard_concept", "label": "graph.json shrink guard", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json() refuses to write graph.json if the new graph has fewer nodes than the existing one, and downstream report/analysis files are only written when the write actually happened - so a broken or partial extraction can never silently overwrite a good graph."}], "edges": [{"source": "claude_skills_graphify_skill_doc", "target": "claude_skills_graphify_references_add_watch_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphif