{"nodes": [{"id": "claude_skills_graphify_references_extraction_spec_doc", "label": "graphify reference: extraction-spec.md", "file_type": "document", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_node_id_format_concept", "label": "Node ID format spec ({stem}_{entity})", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IDs must use the full repo-relative path (every directory level) joined with the entity name so the LLM-generated ID matches the AST extractor's ID exactly; using only the filename or immediate parent creates orphan ghost-duplicate nodes, and IDs must never carry chunk-number suffixes so they stay deterministic."}, {"id": "graphify_confidence_rubric_concept", "label": "Confidence-score rubric (discrete values)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires picking one of five fixed values (0.95/0.85/0.75/0.65/0.55) for INFERRED edges instead of a free continuous range, because production data showed models collapse a continuous 0-1 range into a bimodal split (>50% at 0.5, >40% at 0.85+); discrete rubrics are followed more faithfully."}, {"id": "graphify_extraction_subagent_prompt_concept", "label": "Semantic extraction subagent prompt", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_graphify_references_extraction_spec_doc", "target": "graphify_node_id_format_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_extraction_spec_doc", "target": "graphify_confidence_rubric_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_extraction_spec_doc", "target": "graphify_extraction_subagent_prompt_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}], "hyperedges": []}